# ── Supabase ─────────────────────────────────────────────────────────────────
# These two are intentionally public (NEXT_PUBLIC_ prefix = exposed to browser)
# They are safe to be public — Supabase Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SERVICE ROLE KEY — bypasses RLS. Never expose this to the browser. Server only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── SMS (Vonage) ──────────────────────────────────────────────────────────────
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ── Admin & Security ─────────────────────────────────────────────────────────
ADMIN_API_SECRET=your_random_secret_string
ADMIN_PHONE=+447000000000
CRON_SECRET=your_random_cron_secret
UNSUBSCRIBE_SECRET=your_random_unsubscribe_secret

# ── CCBill (payments) ─────────────────────────────────────────────────────────
# See go-live checklist for setup steps once CCBill account is approved.
CCBILL_CLIENT_ACCNUM=
CCBILL_STARTER_SUBACC=
CCBILL_STARTER_FORM_ID=
CCBILL_STANDARD_SUBACC=
CCBILL_STANDARD_FORM_ID=
CCBILL_EXTRA_MEETING_SUBACC=
CCBILL_EXTRA_MEETING_FORM_ID=
